<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Nexus.Views.Widget.Settings.ShortcutCardSettingsPanel">
    <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
        <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Setting}" FontSize="32" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
        <TextBlock Text="快捷栏暂无额外配置项" 
                   FontSize="14" 
                   Foreground="#9E9E9E" 
                   HorizontalAlignment="Center"/>
        <TextBlock Text="快捷栏会自动显示U盘、高拍仪等可用设备" 
                   FontSize="12" 
                   Foreground="#BDBDBD" 
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="300"/>
    </StackPanel>
</UserControl>
