<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             x:Class="Nexus.Views.AlertWindow">

  <Border CornerRadius="8" Background="{DynamicResource SystemRegionColor}"
          BorderBrush="{DynamicResource SystemControlHighlightAltListAccentHighBrush}"
          BorderThickness="1" Padding="20">
    <StackPanel Spacing="15">
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold"
                 HorizontalAlignment="Center" />
      
      <ScrollViewer MaxHeight="300">
        <TextBlock x:Name="ContentText" FontSize="14" TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
      </ScrollViewer>
      
      <Button x:Name="ConfirmButton" Content="确认" HorizontalAlignment="Center"
              Padding="20,8" Click="ConfirmButton_Click" />
    </StackPanel>
  </Border>
</UserControl>
