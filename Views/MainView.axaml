<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexus.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="Nexus.Views.MainView"
        x:DataType="vm:MainViewModel"
        Title="Nexus"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Mica"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="ListBoxItem.nav-item">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem.nav-item:pointerover">
            <Setter Property="Background" Value="#F9F9F9"/>
        </Style>

        <Style Selector="ListBoxItem.nav-item:selected">
            <Setter Property="Background" Value="#B3E2FF"/>
        </Style>

        <Style Selector="ListBoxItem.nav-item:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#B3E2FF"/>
        </Style>

        <Style Selector="Button.settings-btn">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.settings-btn:pointerover">
            <Setter Property="Background" Value="#F9F9F9"/>
        </Style>

        <Style Selector="ContentControl#ContentFrame">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" 
                Background="Transparent"
                Padding="24,8"
                PointerPressed="OnTitleBarPointerPressed"
                Cursor="Arrow">
            
            <Grid ColumnDefinitions="Auto,*,Auto" 
                  VerticalAlignment="Center"
                  MinHeight="48">
                
                <StackPanel Orientation="Horizontal" 
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Border CornerRadius="12"
                            Width="36"
                            Height="36">
                        <Image Source="avares://Nexus/Assets/hqzx.png" 
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Nexus"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#202122"
                                   FontFamily="Segoe UI Variable"/>
                        <TextBlock Text="{Binding ClassName}"
                                   FontSize="12"
                                   Foreground="#797775"
                                   IsVisible="{Binding ClassName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   FontFamily="Segoe UI Variable"/>
                    </StackPanel>
                </StackPanel>
                
                <Border Grid.Column="1" 
                        Background="#F9F9F9"
                        CornerRadius="16"
                        Padding="8,6,8,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Ellipse Width="8" Height="8" Fill="#107C10"/>
                        <TextBlock Text="{Binding DeviceStatus}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#202122"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="2" 
                        Background="#F9F9F9"
                        CornerRadius="8"
                        Padding="8,6,8,6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="&#xE946;" 
                                   FontSize="12" 
                                   Foreground="#797775" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DeviceIdDisplay}"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   Foreground="#797775"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">

            <Border Background="#F3F3F3" 
                    BorderBrush="#EDEDED" 
                    BorderThickness="0,0,1,0">
                <DockPanel MinWidth="220" 
                           Width="280" 
                           Margin="16,24">
                    
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="主菜单" 
                                   FontSize="12" 
                                   Foreground="#797775" 
                                   FontWeight="Medium" 
                                   Margin="16,0,0,8"
                                   DockPanel.Dock="Top"/>
                        
                        <ListBox ItemsSource="{Binding NavigationItems}"
                                 SelectedIndex="{Binding SelectedNavigationItem}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <Border Background="#B3E2FF" 
                                                CornerRadius="8" 
                                                Width="32" Height="32">
                                            <ui:SymbolIcon Symbol="{Binding IconSymbol}" 
                                                       FontSize="16" 
                                                       Foreground="#0078D4"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Label}" 
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#202122"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Border Height="1" 
                                Background="#EDEDED" 
                                Margin="16,0"
                                DockPanel.Dock="Top"/>
                        
                        <Button Command="{Binding OpenSettingsCommand}"
                                Classes="settings-btn"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border Background="#F9F9F9" 
                                        CornerRadius="8" 
                                        Width="32" Height="32">
                                    <ui:SymbolIcon Symbol="Setting" 
                                               FontSize="16" 
                                               Foreground="#605E5C"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="设置" 
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#605E5C"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    
                </DockPanel>
            </Border>
            
            <Border Grid.Column="1" Background="#F3F3F3">
                <ContentControl x:Name="ContentFrame"
                                Content="{Binding CurrentPage}"/>
            </Border>
            
        </Grid>
    </Grid>

</Window>
