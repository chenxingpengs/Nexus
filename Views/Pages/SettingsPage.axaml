<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Nexus.ViewModels.Pages"
             x:Class="Nexus.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="0,0,0,32">
            
            <StackPanel Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="考勤配置"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1976D2"/>
                <TextBlock Text="配置班级的周期性排班规则与时段人数"
                           FontSize="14"
                           Foreground="#757575"/>
            </StackPanel>

            <Border Background="#FFFFFF" CornerRadius="12" Padding="24"
                    BoxShadow="0 2 8 0 #1A000000"
                    IsVisible="{Binding IsBound}">
                <StackPanel Spacing="24">

                    <Border Background="#F5F5F5" CornerRadius="10" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="#E3F2FD" CornerRadius="8" Padding="10">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Calendar}" FontSize="20" Foreground="#1976D2"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="周期排班" FontSize="16" FontWeight="SemiBold" Foreground="#424242"/>
                                    <TextBlock Text="配置班级在固定时段的周期性排班规则（周一至周五）" 
                                               FontSize="12" Foreground="#757575"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <Border Background="#FFF8E1" CornerRadius="6" Padding="10" IsVisible="{Binding HasMissingSlots}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Important}" FontSize="14" Foreground="#FF9800"/>
                                    <TextBlock Text="存在未配置的排班时段，请完善配置" 
                                               FontSize="12" Foreground="#E65100" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#E8F5E9" CornerRadius="6" Padding="10" IsVisible="{Binding ScheduleComplete}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Accept}" FontSize="14" Foreground="#4CAF50"/>
                                    <TextBlock Text="排班配置完整" 
                                               FontSize="12" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFEBEE" CornerRadius="6" Padding="10" IsVisible="{Binding HasError}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Important}" FontSize="14" Foreground="#E53935"/>
                                    <TextBlock Text="{Binding ErrorMessage}" 
                                               FontSize="12" Foreground="#C62828" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="班级排班规则" FontSize="13" Foreground="#424242" FontWeight="Medium"/>
                                    <TextBlock FontSize="11" Foreground="#9E9E9E">
                                        <Run Text="已配置: "/>
                                        <Run Text="{Binding ConfiguredCount}" Foreground="#4CAF50"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding TotalCount}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Row="0" Grid.Column="1"
                                        Command="{Binding OpenScheduleConfigCommand}"
                                        Background="#1976D2"
                                        CornerRadius="6"
                                        Padding="14,6"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding !IsLoading}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Edit}" FontSize="13" Foreground="White"/>
                                        <TextBlock Text="配置" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Panel IsVisible="{Binding IsLoading}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <ui:ProgressRing IsActive="True" Width="20" Height="20"/>
                                    <TextBlock Text="加载中..." FontSize="11" Foreground="#757575"/>
                                </StackPanel>
                            </Panel>
                        </StackPanel>
                    </Border>

                    <Border Background="#F5F5F5" CornerRadius="10" Padding="20">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="#E8F5E9" CornerRadius="8" Padding="10">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.People}" FontSize="20" Foreground="#2E7D32"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding QuotaClassName, StringFormat='{}{0} 时段人数'}" FontSize="16" FontWeight="SemiBold" Foreground="#424242"/>
                                    <TextBlock FontSize="12" Foreground="#757575">
                                        <Run Text="班级总人数："/>
                                        <Run Text="{Binding QuotaStudentCount}" Foreground="#1976D2" FontWeight="Medium"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="#FFEBEE" CornerRadius="6" Padding="10" IsVisible="{Binding QuotaHasError}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Important}" FontSize="14" Foreground="#E53935"/>
                                    <TextBlock Text="{Binding QuotaErrorMessage}" FontSize="12" Foreground="#C62828" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFF8E1" CornerRadius="6" Padding="10" IsVisible="{Binding HasIncompleteQuotas}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Important}" FontSize="14" Foreground="#FF9800"/>
                                    <TextBlock Text="存在未配置的时段人数，请完善配置" FontSize="12" Foreground="#E65100" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FAFAFA" CornerRadius="6" Padding="14" IsVisible="{Binding QuotaShowContent}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="时段名称" FontSize="13" FontWeight="Medium" Foreground="#424242" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="时间段" FontSize="13" FontWeight="Medium" Foreground="#424242" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0,0,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="应到人数" FontSize="13" FontWeight="Medium" Foreground="#424242" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,0,0"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding QuotaItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:TimeSlotQuotaItem">
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto" Margin="0,6,0,0">
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TimeSlotName}" FontSize="13" Foreground="#424242" VerticalAlignment="Center"/>
                                                        <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Important}" FontSize="12" Foreground="#FF9800" IsVisible="{Binding NeedsConfiguration}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="#757575" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0,0,0">
                                                        <Run Text="{Binding StartTime}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding EndTime}"/>
                                                    </TextBlock>
                                                    <ui:NumberBox Grid.Row="0" Grid.Column="2"
                                                                  Value="{Binding Quota, Mode=TwoWay}"
                                                                  Minimum="0"
                                                                  Maximum="999"
                                                                  MinWidth="80"
                                                                  HorizontalAlignment="Center"
                                                                  Margin="20,0,0,0"
                                                                  SmallChange="1"
                                                                  LargeChange="5"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Panel IsVisible="{Binding QuotaIsLoading}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <ui:ProgressRing IsActive="True" Width="20" Height="20"/>
                                    <TextBlock Text="加载中..." FontSize="11" Foreground="#757575"/>
                                </StackPanel>
                            </Panel>

                            <Button Command="{Binding SaveQuotaCommand}"
                                    Background="#2E7D32"
                                    CornerRadius="6"
                                    Padding="20,8"
                                    HorizontalAlignment="Stretch"
                                    MaxWidth="180"
                                    IsVisible="{Binding QuotaShowSaveButton}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Save}" FontSize="13" Foreground="White"/>
                                    <TextBlock Text="保存配置" Foreground="White" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" CornerRadius="12" Padding="24"
                    BoxShadow="0 2 8 0 #1A000000"
                    IsVisible="{Binding !IsBound}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="#FFEBEE" CornerRadius="8" Padding="10">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Important}" FontSize="20" Foreground="#E53935"/>
                        </Border>
                        <TextBlock Text="设备未绑定" FontSize="18" FontWeight="SemiBold" Foreground="#424242" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="请先绑定设备后再进行考勤配置" 
                               FontSize="14" Foreground="#757575"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
