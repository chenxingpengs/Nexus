<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexus.ViewModels.Pages"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Nexus.Views.Pages.WidgetSettingsPage"
             x:DataType="vm:WidgetSettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="24,20" Spacing="24">
            
            <TextBlock Text="小组件设置" FontSize="24" FontWeight="Bold" Foreground="#1976D2"/>
            
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" BoxShadow="0 2 8 0 #1A000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="基础设置" FontSize="16" FontWeight="SemiBold" Foreground="#424242"/>
                    
                    <Grid ColumnDefinitions="Auto,*" Margin="0,8">
                        <TextBlock Text="启用桌面小组件" 
                                   FontSize="14" 
                                   Foreground="#616161" 
                                   VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" 
                                     IsChecked="{Binding IsWidgetEnabled}"
                                     HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <Grid ColumnDefinitions="Auto,*" Margin="0,8">
                        <TextBlock Text="透明度" 
                                   FontSize="14" 
                                   Foreground="#616161" 
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" 
                                   Orientation="Horizontal" 
                                   Spacing="12"
                                   HorizontalAlignment="Right">
                            <Slider Minimum="0.3" Maximum="1" 
                                   Value="{Binding WidgetOpacity}"
                                   MinWidth="140" Width="200"/>
                            <TextBlock Text="{Binding OpacityPercent}" 
                                       FontSize="14" 
                                       Foreground="#1976D2"
                                       VerticalAlignment="Center"
                                       Width="50"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" BoxShadow="0 2 8 0 #1A000000">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="卡片管理" FontSize="16" FontWeight="SemiBold" Foreground="#424242"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddCardButton"
                                   Click="OnAddCardClick"
                                   CornerRadius="6"
                                   IsEnabled="{Binding HasAvailableCards}"
                                   ToolTip.Tip="添加组件">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Add}" FontSize="14"/>
                                    <TextBlock Text="添加" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveSelectedCardCommand}"
                                   CornerRadius="6"
                                   IsEnabled="{Binding HasSelectedCard}"
                                   ToolTip.Tip="移除选中组件">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Delete}" FontSize="14" Foreground="#E81123"/>
                                    <TextBlock Text="移除" Foreground="#E81123" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    
                    <Border Background="#E3F2FD" CornerRadius="8" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Help}" FontSize="16" Foreground="#1976D2"/>
                            <TextBlock FontSize="13" Foreground="#1976D2" VerticalAlignment="Center">
                                点击卡片查看配置，拖拽排序调整显示顺序
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#F5F5F5" CornerRadius="12" Padding="8" MinHeight="60">
                        <ItemsControl ItemsSource="{Binding EnabledCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" 
                                           CornerRadius="8" 
                                           Padding="12,8"
                                           Margin="4,4"
                                           BorderBrush="{Binding BorderColor}"
                                           BorderThickness="2"
                                           PointerPressed="OnCardPointerPressed"
                                           Cursor="Hand">
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="Background" Value="#F0F7FF"/>
                                            </Style>
                                        </Border.Styles>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="32" Height="32"
                                                   CornerRadius="6"
                                                   Background="#E3F2FD"
                                                   VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CardIcon}"
                                                          FontSize="10"
                                                          FontWeight="Medium"
                                                          Foreground="#1976D2"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding CardName}" 
                                                      FontSize="13" 
                                                      FontWeight="Medium"
                                                      Foreground="#424242"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    
                    <TextBlock Text="已启用组件将显示在桌面小组件中" 
                               FontSize="12" 
                               Foreground="#9E9E9E"
                               IsVisible="{Binding HasEnabledCards}"/>
                    
                    <TextBlock Text="暂无已启用的组件，点击上方添加按钮添加" 
                               FontSize="13" 
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !HasEnabledCards}"/>
                    
                </StackPanel>
            </Border>
            
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" BoxShadow="0 2 8 0 #1A000000"
                   IsVisible="{Binding HasSelectedCard}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding CurrentSettingsTitle}" 
                                   FontSize="16" FontWeight="SemiBold" Foreground="#424242"/>
                        <Border Grid.Column="1" 
                               CornerRadius="4" 
                               Padding="8,4" 
                               Background="#E8F5E9"
                               VerticalAlignment="Center">
                            <TextBlock Text="已启用" FontSize="12" Foreground="#2E7D32" FontWeight="Medium"/>
                        </Border>
                    </Grid>
                    
                    <ContentControl Content="{Binding CurrentSettingsPanel}"/>
                </StackPanel>
            </Border>
            
            <Border Background="#FFFFFF" CornerRadius="12" Padding="20" BoxShadow="0 2 8 0 #1A000000"
                   IsVisible="{Binding !HasSelectedCard}">
                <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20">
                    <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Edit}" FontSize="40" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                    <TextBlock Text="选择上方卡片查看配置" 
                               FontSize="14" 
                               Foreground="#9E9E9E" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="点击已启用的卡片，即可查看和修改该卡片的专属设置" 
                               FontSize="12" 
                               Foreground="#BDBDBD" 
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="300"/>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
    
</UserControl>
