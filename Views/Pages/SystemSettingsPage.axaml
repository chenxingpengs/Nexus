<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Nexus.ViewModels.Pages"
             x:Class="Nexus.Views.Pages.SystemSettingsPage"
             x:DataType="vm:SystemSettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="0,0,0,32">
            
            <StackPanel Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="系统设置"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1976D2"/>
                <TextBlock Text="配置应用程序启动与网络唤醒功能"
                           FontSize="14"
                           Foreground="#757575"/>
            </StackPanel>

            <Border Background="#FFFFFF" CornerRadius="12" Padding="24"
                    BoxShadow="0 2 8 0 #1A000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="启动设置" FontSize="16" FontWeight="SemiBold" Foreground="#424242"/>
                    
                    <Grid ColumnDefinitions="Auto,*" Margin="0,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="开机自启动" 
                                       FontSize="14" 
                                       Foreground="#616161" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="系统启动时自动运行 Nexus" 
                                       FontSize="11" 
                                       Foreground="#9E9E9E"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                     IsChecked="{Binding AutoStart}"
                                     HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" CornerRadius="12" Padding="24"
                    BoxShadow="0 2 8 0 #1A000000">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="#E8F5E9" CornerRadius="8" Padding="10">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Video}" FontSize="20" Foreground="#2E7D32"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="网络唤醒 (Wake-on-LAN)" FontSize="16" FontWeight="SemiBold" Foreground="#424242"/>
                            <TextBlock Text="允许远程开机，程序启动时自动配置网卡 WOL 设置" 
                                       FontSize="12" Foreground="#757575"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Border Background="#E8F5E9" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Accept}" FontSize="14" Foreground="#4CAF50"/>
                                <TextBlock Text="已自动配置" FontSize="12" FontWeight="Medium" Foreground="#2E7D32"/>
                            </StackPanel>
                            <TextBlock Text="程序启动时会自动检测并配置支持 WOL 的以太网网卡" 
                                       FontSize="11" Foreground="#757575" Margin="20,0,0,2"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#FFF8E1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Alert}" FontSize="14" Foreground="#FF9800"/>
                                <TextBlock Text="前置条件" FontSize="12" FontWeight="Medium" Foreground="#E65100"/>
                            </StackPanel>
                            <TextBlock Text="1. BIOS 中需启用 Wake-on-LAN / Power On By PCI-E" 
                                       FontSize="11" Foreground="#757575" Margin="20,0,0,2"/>
                            <TextBlock Text="2. 网卡驱动需支持 WOL 功能" 
                                       FontSize="11" Foreground="#757575" Margin="20,0,0,2"/>
                        </StackPanel>
                    </Border>
                    
                    <Grid ColumnDefinitions="Auto,*" Margin="0,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="本机 MAC 地址" 
                                       FontSize="14" 
                                       Foreground="#616161" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="用于远程唤醒识别" 
                                       FontSize="11" 
                                       Foreground="#9E9E9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding MacAddress}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#1976D2"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
