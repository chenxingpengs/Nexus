<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexus.ViewModels.Pages"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="clr-namespace:Nexus.Converters"
             x:Class="Nexus.Views.Pages.MeetingPage"
             x:DataType="vm:MeetingPageViewModel">

    <UserControl.Resources>
        <converters:BoolToMeetingStatusColorConverter x:Key="BoolToMeetingStatusColorConverter"/>
        <converters:CountToInvertedBoolConverter x:Key="CountToInvertedBoolConverter"/>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="24,20" Spacing="20">
            
            <!-- 手动加入会议 -->
            <Border Background="White" CornerRadius="8" Padding="20" BoxShadow="0 2 8 0 #1A000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="手动加入会议" FontSize="18" FontWeight="Bold" Foreground="#1976D2"/>
                    
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <TextBox Grid.Column="0"
                                 Text="{Binding InputMeetingId}"
                                 Watermark="请输入会议ID"
                                 FontSize="14"
                                 Padding="12,10"/>
                        <Button Grid.Column="1"
                                Content="加入会议"
                                Command="{Binding JoinMeetingCommand}"
                                Background="#1976D2"
                                Foreground="White"
                                CornerRadius="6"
                                Padding="20,10"
                                Margin="12,0,0,0"
                                FontSize="14"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 当前会议状态 -->
            <Border Background="White" CornerRadius="8" Padding="20" BoxShadow="0 2 8 0 #1A000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="当前会议状态" FontSize="18" FontWeight="Bold" Foreground="#1976D2"/>
                    
                    <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                        <Ellipse Width="12" Height="12" 
                                 VerticalAlignment="Center"
                                 Fill="{Binding IsInMeeting, Converter={StaticResource BoolToMeetingStatusColorConverter}}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MeetingStatus}"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsInMeeting}">
                        <TextBlock Text="会议名称:" Foreground="#666" FontSize="13"/>
                        <TextBlock Text="{Binding CurrentMeetingTitle}" FontSize="13" FontWeight="Medium"/>
                    </StackPanel>

                    <Button Content="离开会议"
                            Command="{Binding LeaveMeetingCommand}"
                            IsVisible="{Binding IsInMeeting}"
                            Background="#F44336"
                            Foreground="White"
                            CornerRadius="6"
                            Padding="20,10"
                            HorizontalAlignment="Left"
                            FontSize="14"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 会议历史 -->
            <Border Background="White" CornerRadius="8" Padding="20" BoxShadow="0 2 8 0 #1A000000">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="会议历史" FontSize="18" FontWeight="Bold" Foreground="#1976D2"/>
                        <Button Grid.Column="1"
                                Content="刷新"
                                Command="{Binding RefreshHistoryCommand}"
                                Background="Transparent"
                                Foreground="#1976D2"
                                BorderBrush="#1976D2"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,6"
                                FontSize="12"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding MeetingHistory}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F5F5" CornerRadius="6" Padding="16" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="●" FontSize="12" Foreground="#1976D2" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="14" FontWeight="Medium"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding HostName}"
                                                   FontSize="12" Foreground="#666"/>
                                        
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                            <TextBlock FontSize="12" Foreground="#888">
                                                <Run Text="时长:"/>
                                                <Run Text="{Binding Duration}"/>
                                                <Run Text="分钟"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#888"
                                                       Text="{Binding StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="暂无会议历史"
                               FontSize="14"
                               Foreground="#999"
                               HorizontalAlignment="Center"
                               Margin="0,20"
                               IsVisible="{Binding MeetingHistory.Count, Converter={StaticResource CountToInvertedBoolConverter}}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
